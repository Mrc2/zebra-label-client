<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="debug" xsi:schemaLocation="http://logging.apache.org/log4j/2.0/config https://logging.apache.org/log4j/2.x/log4j-core/apidocs/org/apache/logging/log4j/core/config/plugins/Log4j2.xsd"
               xmlns="http://logging.apache.org/log4j/2.0/config"
               name="XMLConfigTest" 
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <Properties>
        <Property name="APP_NAME">zebralabels</Property>
        <Property name="LOG_DIR">${sys:catalina.home}/logs</Property>
    </Properties>
    <Filter type="ThresholdFilter" level="trace"/>
    <Console name="Console" target="SYSTEM_OUT" level="warn">
            <PatternLayout pattern="%d{HH:mm:ss,SSS} [%t] %-5p %c{1} %logger{36} - %msg%n"/>
    </Console>
    <Appenders>
        <RollingFile name="RollingFile"
                     fileName="${LOG_DIR}/${APP_NAME}.log"
                     filePattern="${LOG_DIR}/${APP_NAME}-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} [%L] - %msg%n</pattern>
            </PatternLayout>

            <Policies>
                <!-- Roll over at midnight -->
                <TimeBasedTriggeringPolicy/>
                <!-- Roll over when file reaches 50 MB -->
                <SizeBasedTriggeringPolicy size="50 MB"/>
            </Policies>

            <DefaultRolloverStrategy max="30">
                <!-- Gzip old files and delete logs older than 30 days -->
                <Delete basePath="${LOG_DIR}" maxDepth="2">
                    <IfFileName glob="${APP_NAME}-*.log.gz"/>
                    <IfLastModified age="30d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!-- Optional: Separate error-only log for easier monitoring -->
        <RollingFile name="ErrorFile"
                     fileName="${LOG_DIR}/${APP_NAME}-fatal.log"
                     filePattern="${LOG_DIR}/${APP_NAME}-error-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} [%c{1}:%L] - %msg%n</pattern>
            </PatternLayout>
            <Filters>
                <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            </Filters>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="50 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="90"/>
        </RollingFile>
    </Appenders>
    
    <Loggers>

        <!--        <Logger name="com.oldworldind" level="trace" additivity="false">
        <Root level="info" additivity="false">
            <AppenderRef ref="Console"/>
        </Root>
        -->
        <Logger name="com.oldworldind.app" level="trace" additivity="false">
            <AppenderRef ref="RollingFile"/>
            <AppenderRef ref="Console"/>
        </Logger>

        <Root level="info"> 
            <Appender-ref ref="RollingFile" />
            <Appender-ref ref="Console" />
            <!--<Appender-ref ref="EMAIL" />-->
        </Root> 
    </Loggers>
</Configuration>